{
  "auto_apply_patches": false,
  "bind_addr": "127.0.0.1:8085",
  "osv_endpoint": "https://api.osv.dev/v1",
  "memory_limit_mb": 512,
  "llm": {
    "backend": "openai",
    "openai_base_url": "http://127.0.0.1:11434/v1",
    "openai_model": "qwen2.5-coder:1.5b",
    "nim_base_url": "https://integrate.api.nvidia.com/v1",
    "nim_model": "meta/llama-3.1-8b-instruct",
    "llama_model": "tiny",
    "temperature": 0.3,
    "max_tokens": 1024,
    "openai_api_key": ""
  },
  "workspace_dir": "./workspace",
  "sandbox_allow_commands": [
    "go",
    "python",
    "python3",
    "py",
    "node",
    "npm",
    "npx",
    "bun",
    "git",
    "cargo",
    "rustc",
    "dotnet",
    "gcc",
    "g++",
    "clang",
    "make",
    "cmake",
    "pytest",
    "java",
    "javac",
    "mvn",
    "gradle",
    "curl",
    "wget",
    "tar",
    "unzip",
    "zip",
    "mkdir",
    "cp",
    "mv",
    "cat",
    "echo",
    "grep",
    "find",
    "ls",
    "dir",
    "cd",
    "where",
    "pwd"
  ],
  "sandbox_timeout_sec": 120,
  "rate_limit_per_min": 60
}